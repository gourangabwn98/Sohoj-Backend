# ── Add these 3 variables to your existing restaurant server .env ─────────────
# Get these values from DAB super admin panel after creating the restaurant

# Your unique restaurant identifier
RESTAURANT_ID=kolhad_001

# DAB server URL (where dab-server is deployed)
DAB_API_URL=https://dab-server.onrender.com

# Your restaurant's API key (from DAB credentials page)
DAB_API_KEY=dab_abc123xyz_1234567890

# ── Your existing .env variables stay the same ────────────────────────────────
PORT=5000
MONGO_URI=mongodb+srv://.../<dbName from DAB>
JWT_SECRET=your_existing_secret
# ... rest of your existing .env
